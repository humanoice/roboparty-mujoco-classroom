<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixed window layout for the 1280x720 (720p) classroom desktop (small screen = less CPU). -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application title="MuJoCo*">
      <position force="yes"><x>0</x><y>0</y></position>
      <size><width>800</width><height>690</height></size>
      <focus>no</focus>
    </application>
    <application title="Robot remote">
      <position force="yes"><x>800</x><y>0</y></position>
    </application>
    <application title="party terminal">
      <position force="yes"><x>800</x><y>360</y></position>
      <size><width>480</width><height>335</height></size>
    </application>
  </applications>
</openbox_config>
